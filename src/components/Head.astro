---
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const ogImageUrl = new URL(`/open-graph/${entry.id}.png`, Astro.site ?? Astro.url).href;
---
<Default {...Astro.props} />

<!-- Per-page social preview image, generated at build time -->
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicons — served from CDN -->
<link rel="icon" type="image/svg+xml" href="https://assets.cocolotravel.com/favicon/favicon.svg" />
<link rel="icon" type="image/x-icon" href="https://assets.cocolotravel.com/favicon/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="https://assets.cocolotravel.com/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="https://assets.cocolotravel.com/favicon/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="https://assets.cocolotravel.com/favicon/favicon-180x180.png" />
<link rel="apple-touch-icon" sizes="152x152" href="https://assets.cocolotravel.com/favicon/favicon-152x152.png" />
<link rel="apple-touch-icon" sizes="144x144" href="https://assets.cocolotravel.com/favicon/favicon-144x144.png" />
<link rel="icon" type="image/png" sizes="192x192" href="https://assets.cocolotravel.com/favicon/favicon-192x192.png" />
<meta name="msapplication-TileImage" content="https://assets.cocolotravel.com/favicon/favicon-144x144.png" />
<meta name="msapplication-TileColor" content="#1b3848" />
<meta name="msapplication-config" content="https://assets.cocolotravel.com/favicon/browserconfig.xml" />
