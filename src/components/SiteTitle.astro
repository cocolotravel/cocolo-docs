---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

const spaceIndex = siteTitle.indexOf(' ');
const firstWord = spaceIndex !== -1 ? siteTitle.slice(0, spaceIndex) : siteTitle;
const rest = spaceIndex !== -1 ? siteTitle.slice(spaceIndex) : '';

const CDN = 'https://assets.cocolotravel.com/logos/svg';
---

<a href={siteTitleHref} class="site-title sl-flex">
  <!-- Washi (cream) logo — shown in dark mode -->
  <img
    class="light:sl-hidden"
    src={`${CDN}/logo_cloud_logo_full_washi.svg`}
    alt="Cocolo"
  />
  <!-- Sumi (dark ink) logo — shown in light mode -->
  <img
    class="dark:sl-hidden"
    src={`${CDN}/logo_cloud_logo_full_sumi.svg`}
    alt="Cocolo"
  />
  <span translate="no">
    <span class="title-serif">{firstWord}</span>{rest}
  </span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      font-size: var(--sl-text-h4);
      font-weight: 600;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    span {
      overflow: hidden;
    }
    img {
      height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: 0 50%;
    }
  }

  .title-serif {
    font-family: var(--font-style-roslindale), 'RoslindaleDisplay', Georgia, serif;
  }
</style>
